{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PERSIA / GOLDENCROWN Common Leaderboard Snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "clan",
    "official_timestamp_persian",
    "member_count",
    "baseline_rule",
    "members"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Z]-S[0-9]+$"
    },
    "clan": {
      "type": "string",
      "minLength": 1
    },
    "official_timestamp_persian": {
      "type": "string",
      "minLength": 1
    },
    "captured_at_utc": {
      "type": "string"
    },
    "member_count": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_rule": {
      "type": "object",
      "required": [
        "total_kills",
        "clan_medals"
      ],
      "properties": {
        "total_kills": {
          "enum": [
            "baseline",
            "cumulative"
          ]
        },
        "clan_medals": {
          "enum": [
            "baseline",
            "cumulative"
          ]
        },
        "kills_delta": {
          "type": [
            "null",
            "number"
          ]
        },
        "clan_medals_delta": {
          "type": [
            "null",
            "number"
          ]
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "snapshot_member_key",
          "rank",
          "display_name",
          "role",
          "stage",
          "league_medals",
          "total_kills",
          "clan_medals"
        ],
        "properties": {
          "snapshot_member_key": {
            "type": "string"
          },
          "player_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rank_movement": {
            "type": [
              "integer",
              "null"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "integer",
            "minimum": 0
          },
          "league_medals": {
            "type": "integer",
            "minimum": 0
          },
          "league_medals_delta": {
            "type": [
              "integer",
              "null"
            ]
          },
          "clan_medals": {
            "type": "integer",
            "minimum": 0
          },
          "clan_medals_delta": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total_kills": {
            "type": "integer",
            "minimum": 0
          },
          "kills_delta": {
            "type": [
              "integer",
              "null"
            ]
          },
          "honor_medals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "silver": {
                "type": "integer",
                "minimum": 0
              },
              "bronze": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "weapons": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "25mm": {
                "type": "integer",
                "minimum": 0
              },
              "hydra": {
                "type": "integer",
                "minimum": 0
              },
              "hellfire": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "last_online_display": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}